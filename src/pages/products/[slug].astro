---
import Layout from '../../layouts/Layout.astro';
import { getProducts, getProductBySlug } from '../../lib/woocommerce';
import AddToCartButton from '../../components/AddToCartButton.tsx';

// output: 'static' 必須實作 getStaticPaths()
export async function getStaticPaths() {
  const products = await getProducts({ per_page: 100 });
  return products.map((p: any) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = await getProductBySlug(slug!);

if (!product) {
  return Astro.redirect('/products');
}
---

<Layout title={`${product.name} - 我的商店`} description={product.short_description?.replace(/<[^>]+>/g, '') ?? product.name}>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start;">
    <!-- 商品圖片 -->
    <div>
      {product.images?.[0] && (
        <img src={product.images[0].src} alt={product.name}
          width="600" height="600"
          style="width: 100%; border-radius: 12px; object-fit: cover;" />
      )}
      {product.images?.length > 1 && (
        <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
          {product.images.slice(1, 5).map((img: any) => (
            <img src={img.src} alt={img.alt || product.name}
              width="100" height="100"
              style="width: 80px; height: 80px; object-fit: cover; border-radius: 6px; border: 1px solid #e5e7eb;" />
          ))}
        </div>
      )}
    </div>

    <!-- 商品資訊 -->
    <div>
      <p style="font-size: 0.875rem; color: #6b7280; margin-bottom: 0.5rem;">
        {product.categories?.map((c: any) => c.name).join(' / ')}
      </p>
      <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 1rem;">{product.name}</h1>
      <div style="font-size: 1.75rem; font-weight: 700; margin-bottom: 1.5rem;" set:html={product.price_html} />

      {product.short_description && (
        <div style="color: #4b5563; margin-bottom: 1.5rem; line-height: 1.6;" set:html={product.short_description} />
      )}

      <div style="margin-bottom: 1rem;">
        {product.stock_status === 'instock' ? (
          <span style="color: #10b981; font-size: 0.875rem; font-weight: 600;">✓ 有庫存</span>
        ) : (
          <span style="color: #ef4444; font-size: 0.875rem; font-weight: 600;">✕ 缺貨中</span>
        )}
      </div>

      {product.stock_status === 'instock' && (
        <AddToCartButton client:load productId={product.id} productName={product.name} />
      )}

      {product.description && (
        <div style="margin-top: 2.5rem; border-top: 1px solid #e5e7eb; padding-top: 2rem;">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem;">商品詳情</h2>
          <div style="line-height: 1.7; color: #4b5563;" set:html={product.description} />
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
