---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/LoginForm.tsx';
---

<Layout title="登入 - 我的商店">
  <div style="max-width: 420px; margin: 4rem auto;">
    <h1 style="font-size: 2rem; font-weight: 700; text-align: center; margin-bottom: 2rem;">登入</h1>
    <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; padding: 2.5rem;">
      <LoginForm client:load />
    </div>
  </div>
</Layout>
